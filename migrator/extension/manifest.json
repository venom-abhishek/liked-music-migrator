{
  "manifest_version": 3,
  "name": "Music Mover for YouTube Music",
  "version": "0.2.0",
  "description": "Tidy up YouTube Music and bring in songs from JioSaavn and Amazon Music. No accounts, no servers, and every change can be undone.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Music Mover",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.jiosaavn.com/*",
    "https://*.jiosaavn.com/*",
    "https://music.amazon.com/*",
    "https://music.amazon.in/*",
    "https://music.amazon.co.uk/*",
    "https://music.amazon.de/*",
    "https://music.amazon.fr/*",
    "https://music.amazon.it/*",
    "https://music.amazon.es/*",
    "https://music.amazon.co.jp/*",
    "https://music.amazon.com.au/*",
    "https://music.amazon.com.br/*",
    "https://music.amazon.com.mx/*",
    "https://music.amazon.ca/*",
    "https://music.amazon.nl/*",
    "https://music.amazon.se/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/ytmusic/bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/ytmusic/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.jiosaavn.com/*",
        "https://*.jiosaavn.com/*"
      ],
      "js": [
        "src/sources/jiosaavn.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.amazon.com/*",
        "https://music.amazon.in/*",
        "https://music.amazon.co.uk/*",
        "https://music.amazon.de/*",
        "https://music.amazon.fr/*",
        "https://music.amazon.it/*",
        "https://music.amazon.es/*",
        "https://music.amazon.co.jp/*",
        "https://music.amazon.com.au/*",
        "https://music.amazon.com.br/*",
        "https://music.amazon.com.mx/*",
        "https://music.amazon.ca/*",
        "https://music.amazon.nl/*",
        "https://music.amazon.se/*"
      ],
      "js": [
        "src/sources/amazon-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.amazon.com/*",
        "https://music.amazon.in/*",
        "https://music.amazon.co.uk/*",
        "https://music.amazon.de/*",
        "https://music.amazon.fr/*",
        "https://music.amazon.it/*",
        "https://music.amazon.es/*",
        "https://music.amazon.co.jp/*",
        "https://music.amazon.com.au/*",
        "https://music.amazon.com.br/*",
        "https://music.amazon.com.mx/*",
        "https://music.amazon.ca/*",
        "https://music.amazon.nl/*",
        "https://music.amazon.se/*"
      ],
      "js": [
        "src/sources/amazon-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
